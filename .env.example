VITIGUARD_APP_NAME="VitiGuard MD API"
VITIGUARD_ENVIRONMENT=local
VITIGUARD_DEBUG=false
VITIGUARD_API_V1_PREFIX=/api/v1
VITIGUARD_DATABASE_URL=postgresql+asyncpg://vitiguard:vitiguard@127.0.0.1:5432/vitiguard
VITIGUARD_DATABASE_POOL_SIZE=10
VITIGUARD_DATABASE_MAX_OVERFLOW=10
VITIGUARD_DATABASE_POOL_TIMEOUT=30

# Docker Compose; пароли по умолчанию — только для локальной разработки
API_PORT=8000
POSTGRES_USER=vitiguard
POSTGRES_PASSWORD=vitiguard
POSTGRES_DB=vitiguard
POSTGRES_PORT=5432
REDIS_PORT=6379
