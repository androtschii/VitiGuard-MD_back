VITIGUARD_APP_NAME="VitiGuard MD API"
VITIGUARD_ENVIRONMENT=local
VITIGUARD_DEBUG=false
VITIGUARD_API_V1_PREFIX=/api/v1
VITIGUARD_DATABASE_URL=postgresql+asyncpg://vitiguard:vitiguard@127.0.0.1:5432/vitiguard
VITIGUARD_DATABASE_POOL_SIZE=10
VITIGUARD_DATABASE_MAX_OVERFLOW=10
VITIGUARD_DATABASE_POOL_TIMEOUT=30
VITIGUARD_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
VITIGUARD_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
VITIGUARD_CELERY_TASK_SOFT_TIME_LIMIT=300
VITIGUARD_CELERY_TASK_TIME_LIMIT=330
# Ключ подписи токенов. В staging и production обязателен свой, не короче 32 символов:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# VITIGUARD_SECRET_KEY=
VITIGUARD_ACCESS_TOKEN_TTL_MINUTES=15
VITIGUARD_REFRESH_TOKEN_TTL_DAYS=30

# Docker Compose; пароли по умолчанию — только для локальной разработки
API_PORT=8000
POSTGRES_USER=vitiguard
POSTGRES_PASSWORD=vitiguard
POSTGRES_DB=vitiguard
POSTGRES_PORT=5432
REDIS_PORT=6379
CELERY_CONCURRENCY=2
